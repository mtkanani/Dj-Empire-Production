# Application Configuration
PORT=3000
NODE_ENV=development
APP_NAME=Event Booking Platform
API_VERSION=v1

# MongoDB Atlas Connection URL (Prisma)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/djempire?retryWrites=true&w=majority"

# JWT Authentication Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Default Credentials (for seeding)
SUPER_ADMIN_EMAIL=admin@eventbooking.com
SUPER_ADMIN_PASSWORD=SuperAdminPassword123!

# SMTP — must also be set on Render (local .env is not uploaded).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_PASS=Google App Password (2FA on).
# Hostinger mailbox (often more reliable from Render):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Event Booking Platform <you@gmail.com>"

# Optional aliases (same meaning as SMTP_*)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=

