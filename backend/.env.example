# Application Configuration
PORT=3000
NODE_ENV=development
APP_NAME=Event Booking Platform
API_VERSION=v1

# MongoDB Atlas Connection URL (Prisma)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/djempire?retryWrites=true&w=majority"

# JWT Authentication Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_32_chars_min
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Default Credentials (for seeding)
SUPER_ADMIN_EMAIL=admin@eventbooking.com
SUPER_ADMIN_PASSWORD=SuperAdminPassword123!

# SMTP — must also be set on Render (local .env is not uploaded).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_PASS=Google App Password (2FA on).
# Hostinger mailbox (often more reliable from Render):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Event Booking Platform <you@gmail.com>"

# Public API and CORS configuration
API_PUBLIC_URL=https://dj-empire-production.onrender.com
CORS_ORIGIN=https://djempireproductions.com,https://www.djempireproductions.com

# Cloudflare R2 (private identity-document storage). Required in production —
# Render's filesystem is ephemeral. Leave blank locally to use disk fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Cash booking inventory hold (hours)
CASH_BOOKING_EXPIRY_HOURS=24

# Optional Razorpay (online payments stay disabled until both keys are set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

